# Database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sales_inventory
DB_USER=sales_app
DB_PASSWORD=your_mysql_password

# JWT authentication
JWT_SECRET_KEY=replace_with_a_new_random_secret
JWT_EXPIRE_MINUTES=60

# Manager account
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=replace_with_a_strong_password

# Order approval threshold
APPROVAL_THRESHOLD=50000.00

# Email / SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_new_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true